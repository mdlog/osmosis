{
  "manifest_version": 3,
  "name": "Osmosis — learn a language from the web you read",
  "short_name": "Osmosis",
  "version": "0.1.0",
  "description": "Turns the pages you already read into a graded reader at your level. Private on-device AI with Firebase AI Logic hybrid inference.",
  "minimum_chrome_version": "139",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.googleapis.com/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Osmosis",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
